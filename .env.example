# ============================================================
# .env.example
# ============================================================

# --- LLM Provider ---
GEMINI_API_KEY=your_gemini_api_key_here

# Model tiers — active Gemini 3.5 / 3.7 models
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite
GEMINI_MODEL_MID=gemini-3.5-flash
GEMINI_MODEL_STRONG=gemini-3.7-flash

# --- Search ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Database (SQLite local zero-config checkpointing) ---
DATABASE_URL=sqlite:///state.db
SQLITE_DB_PATH=state.db

# --- Gmail / Calendar MCP ---
GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
GMAIL_MCP_ENABLED=true
SEND_ACTUAL_EMAILS=false

# --- Guardrails / cost caps ---
MAX_RESEARCHER_ACTIONS=5
MAX_PLANNER_ANGLES=6
MAX_RESOLVER_PENALTIES=3
MAX_RETRY_ROUNDS=2
MAX_JOB_COST_USD=0.50
FOLLOW_UP_DELAY_DAYS=3

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO